---
import BaseLayout from '../layouts/BaseLayout.astro';
import MasonryGallery from '../components/MasonryGallery.astro';
import Lightbox from '../components/Lightbox.tsx';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { galleryImage } from '../lib/galleryImages';
import { withBase } from '../lib/withBase';
import { getSite } from '../lib/site';
import '../styles/lightbox.css';

const site = await getSite();

const entries = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);
const images = await Promise.all(
  entries.map(async (e) => {
    const optimized = await getImage({ src: galleryImage(e.id), format: 'webp', quality: 85 });
    return { src: optimized.src, alt: e.data.alt };
  }),
);
---

<BaseLayout title={`${site.ui.galleryPageHeading} | ${site.brand}`}>
  <nav class="gallery-nav">
    <a href={withBase('/')}>{site.ui.galleryBackLabel}</a>
  </nav>

  <section class="gallery-page">
    <h1>{site.ui.galleryPageHeading}</h1>
    <MasonryGallery />
  </section>

  <Lightbox client:idle images={images} />
</BaseLayout>
