---
import BaseLayout from '../layouts/BaseLayout.astro';
import MasonryGallery from '../components/MasonryGallery.astro';
import Lightbox from '../components/Lightbox.tsx';
import { getImage } from 'astro:assets';
import { galleryImages } from '../lib/galleryImages';
import { withBase } from '../lib/withBase';
import { getSite } from '../lib/site';
import '../styles/lightbox.css';

const site = await getSite();

const images = await Promise.all(
  galleryImages.map(async ({ image }) => {
    const optimized = await getImage({ src: image, format: 'webp', quality: 85 });
    return { src: optimized.src, alt: 'Ilustração — Nardi Sketch' };
  }),
);
---

<BaseLayout title={`${site.ui.galleryPageHeading} | ${site.brand}`}>
  <nav class="gallery-nav">
    <a href={withBase('/')}>{site.ui.galleryBackLabel}</a>
  </nav>

  <section class="gallery-page">
    <h1>{site.ui.galleryPageHeading}</h1>
    <MasonryGallery />
  </section>

  <Lightbox client:load images={images} />
</BaseLayout>
