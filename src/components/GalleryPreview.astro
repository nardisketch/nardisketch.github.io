---
import { Image } from 'astro:assets';
import featured from '../data/featured.json';
import { galleryImage } from '../lib/galleryImages';
import { withBase } from '../lib/withBase';
import { getSite } from '../lib/site';

const site = await getSite();
---

<section id="destaques" class="gallery">
  <h1>{site.ui.galleryHeading}</h1>

  <div class="featured-grid">
    {(featured as string[]).map((name) => (
      <div class="gallery-item">
        <Image
          src={galleryImage(name)}
          alt="Ilustração — Nardi Sketch"
          widths={[300, 600]}
          sizes="(max-width: 600px) 50vw, (max-width: 900px) 33vw, 20vw"
        />
      </div>
    ))}
  </div>

  <a href={withBase('/gallery.html')} class="gallery-button">{site.ui.galleryButton}</a>
</section>
